# cs-mcp 环境变量示例。复制为 .env 并按需修改。
# 注意：.env 不要提交到版本库。

# --- 数据源 ---
# PandaScore token（免费档足够）。缺失时：cs_live_matches 恒返回 NO_DATA。
PANDASCORE_TOKEN=

# HLTV 抓取开关，默认 0。开启前请阅读 README「已知限制」：
# hltv.org 实测返回 403 + cf-mitigated: challenge，且 ToS 禁止爬取。
ENABLE_HLTV_SCRAPE=0

# 留空即直连；国内网络建议填本地代理。
CS_MCP_HTTP_PROXY=
HTTP_TIMEOUT_SECS=5

# --- 缓存 TTL（秒）---
CACHE_TTL_SCHEDULE=120
CACHE_TTL_LIVE=30
CACHE_TTL_RANK=3600

# --- 时区与限流 ---
TZ=Asia/Shanghai
GLOBAL_QPS=2

# --- 传输 ---
MCP_TRANSPORT=stdio
MCP_BIND=0.0.0.0:8080

# --- 日志 ---
RUST_LOG=info
